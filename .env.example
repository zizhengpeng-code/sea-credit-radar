# 大模型（OpenAI 兼容接口，换供应商只改这三个变量）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 推送（按 config.yaml 里 notify.method 选择其一）
SERVERCHAN_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# 跨供应商对比：用「模型名@档案名」指定，读取 LLM_<档案名>_BASE_URL / _API_KEY，互不干扰
#   python eval/run_eval.py --model deepseek-chat glm-4-flash@zhipu qwen-plus@qwen
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=
# LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_QWEN_API_KEY=
# Claude（内部走 anthropic SDK）：claude-sonnet-4-6@claude，需 LLM_CLAUDE_API_KEY
# LLM_CLAUDE_API_KEY=
# 本地 Ollama 不需要 key：LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b

# CI 中覆盖 config.yaml 的推送方式：serverchan | email | none
# NOTIFY_METHOD=serverchan
